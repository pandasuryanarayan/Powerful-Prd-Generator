# ==============================================================================
# PRD Generator Environment Configuration
# ==============================================================================
#
# 1. LOCAL PRD GENERATION (Default / Offline Mode):
#    - NO API keys or configuration required!
#    - Works 100% offline out-of-the-box using built-in domain blueprints
#      (Gaming, FinTech, E-Commerce, SaaS, AI, Social, Education, Custom).
#
# 2. AI-POWERED PRD GENERATION (Nara AI Router):
#    - Required ONLY if you use the "Generate with AI" mode.
#    - Get your API key from Nara Router: https://router.bynara.id
# ==============================================================================

# Nara Router API Key (Required for AI PRD Generation)
NARA_API_KEY=your_nara_router_api_key_here

# Nara Router Base URL (Optional - defaults to https://router.bynara.id/v1)
NARA_BASE_URL=https://router.bynara.id/v1

# ==============================================================================
# Server & Deployment Configuration (Zoho Catalyst AppSail / Node.js)
# ==============================================================================

# Port (Defaults to 3000, or X_ZOHO_CATALYST_LISTEN_PORT in Zoho Catalyst)
PORT=3000

# Node Environment
NODE_ENV=production
